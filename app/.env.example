# ---------------------------------------------------------------------------
# Restohub POS environment
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Lane identity shown in the header and on the sign-in panel.
NEXT_PUBLIC_POS_LANE="Lane 04"
NEXT_PUBLIC_POS_TERMINAL="Main Terminal"

# --- Phase 2: Supabase -----------------------------------------------------
# From Supabase dashboard → Project Settings → API.
# NEXT_PUBLIC_* values are inlined at build time, so they must be present when
# you run `npm run build` / `npm run cf:build`, not only at runtime.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Flip these to "supabase" once supabaseAdapter / supabaseAuth are implemented.
NEXT_PUBLIC_POS_DATA_SOURCE="mock"
NEXT_PUBLIC_POS_AUTH="dummy"

# Service-role key — server-side only, never prefixed NEXT_PUBLIC_.
# Needed only for admin scripts (seeding, back-office jobs).
# SUPABASE_SERVICE_ROLE_KEY=""
