# ---------------------------------------------------------------------------
# Restohub POS environment
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Lane identity shown in the header and on the sign-in panel.
NEXT_PUBLIC_POS_LANE="AGUIRRE"
NEXT_PUBLIC_POS_TERMINAL="Main Terminal"

# --- Phase 2: Supabase -----------------------------------------------------
# From Supabase dashboard → Project Settings → API.
# NEXT_PUBLIC_* values are inlined at build time, so they must be present when
# you run `npm run build` / `npm run cf:build`, not only at runtime.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Default data mode when a manager hasn't chosen one in the app: "mock" (demo)
# or "supabase" (actual). Managers can switch at runtime under Data Mode, and can
# paste the Supabase URL + anon key there instead of using the two vars above.
NEXT_PUBLIC_POS_DATA_SOURCE="mock"

# Service-role key — server-side only, never prefixed NEXT_PUBLIC_.
# Needed for the Staff page (creating logins) and admin scripts. In production
# set both as Worker secrets: `npx wrangler secret put SUPABASE_URL` and
# `npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY`.
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
